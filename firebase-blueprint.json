{
  "entities": {
    "CenterSettings": {
      "title": "CenterSettings",
      "description": "Configuration and visual branding settings for Meet Azzoun Medical Complex",
      "type": "object",
      "properties": {
        "complexName": {
          "type": "string",
          "description": "Name of the medical complex",
          "minLength": 1,
          "maxLength": 120
        },
        "associationName": {
          "type": "string",
          "description": "Name of the community association",
          "minLength": 1,
          "maxLength": 160
        },
        "registrationNumber": {
          "type": "string",
          "description": "Official registration number of the association",
          "minLength": 1,
          "maxLength": 60
        },
        "rightLogoUrl": {
          "type": "string",
          "description": "URL or path for the top-right medical complex logo",
          "minLength": 1,
          "maxLength": 500
        },
        "leftLogoUrl": {
          "type": "string",
          "description": "URL or path for the top-left association logo",
          "minLength": 1,
          "maxLength": 500
        },
        "address": {
          "type": "string",
          "description": "Physical address displayed in the footer bar",
          "minLength": 1,
          "maxLength": 200
        },
        "whatsappPhone": {
          "type": "string",
          "description": "WhatsApp phone number in the footer",
          "minLength": 1,
          "maxLength": 40
        },
        "landlinePhone": {
          "type": "string",
          "description": "Landline phone number in the footer",
          "minLength": 1,
          "maxLength": 40
        },
        "dentalPhone": {
          "type": "string",
          "description": "Dental clinic phone number in the footer",
          "minLength": 1,
          "maxLength": 40
        },
        "dentalLabel": {
          "type": "string",
          "description": "Label under the dental phone number",
          "minLength": 1,
          "maxLength": 60
        },
        "bgStartColor": {
          "type": "string",
          "description": "Poster background gradient start color",
          "minLength": 4,
          "maxLength": 30
        },
        "bgEndColor": {
          "type": "string",
          "description": "Poster background gradient end color",
          "minLength": 4,
          "maxLength": 30
        },
        "clinicHeaderColor": {
          "type": "string",
          "description": "Header color for the Clinic column",
          "minLength": 4,
          "maxLength": 30
        },
        "doctorHeaderColor": {
          "type": "string",
          "description": "Header color for the Doctor column",
          "minLength": 4,
          "maxLength": 30
        },
        "fromHeaderColor": {
          "type": "string",
          "description": "Header color for the From Time column",
          "minLength": 4,
          "maxLength": 30
        },
        "toHeaderColor": {
          "type": "string",
          "description": "Header color for the To Time column",
          "minLength": 4,
          "maxLength": 30
        },
        "footerBgColor": {
          "type": "string",
          "description": "Footer dark blue background color",
          "minLength": 4,
          "maxLength": 30
        },
        "postTemplate": {
          "type": "string",
          "description": "Customizable template for daily social media and Facebook posts",
          "maxLength": 2000
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of the user who last updated settings",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByEmail": {
          "type": "string",
          "description": "Email of the user who last updated settings",
          "minLength": 3,
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update"
        }
      },
      "required": [
        "complexName",
        "associationName",
        "registrationNumber",
        "rightLogoUrl",
        "leftLogoUrl",
        "address",
        "whatsappPhone",
        "landlinePhone",
        "dentalPhone",
        "dentalLabel",
        "bgStartColor",
        "bgEndColor",
        "clinicHeaderColor",
        "doctorHeaderColor",
        "fromHeaderColor",
        "toHeaderColor",
        "footerBgColor",
        "updatedBy",
        "updatedByEmail",
        "updatedAt"
      ]
    },
    "DailySchedule": {
      "title": "DailySchedule",
      "description": "Schedule document for one day of the week containing both draft and published clinic rows",
      "type": "object",
      "properties": {
        "dayId": {
          "type": "string",
          "description": "Day identifier",
          "enum": ["saturday", "sunday", "monday", "tuesday", "wednesday", "thursday", "friday"],
          "minLength": 6,
          "maxLength": 12
        },
        "dayLabel": {
          "type": "string",
          "description": "Arabic display name of the day",
          "minLength": 3,
          "maxLength": 30
        },
        "dayOrder": {
          "type": "number",
          "description": "Numeric order of the day (0 to 6)"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the published schedule is visible to the public"
        },
        "hasUnpublishedChanges": {
          "type": "boolean",
          "description": "Whether draftRows differ from publishedRows"
        },
        "version": {
          "type": "number",
          "description": "Monotonically increasing revision number for concurrency conflict detection"
        },
        "draftRows": {
          "type": "array",
          "description": "List of clinic schedule rows in draft mode (max 60)"
        },
        "publishedRows": {
          "type": "array",
          "description": "List of clinic schedule rows currently published for public view (max 60)"
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of the last editor",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedByEmail": {
          "type": "string",
          "description": "Email of the last editor",
          "minLength": 3,
          "maxLength": 160
        },
        "updatedByName": {
          "type": "string",
          "description": "Display name of the last editor",
          "minLength": 1,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last edit"
        },
        "publishedAt": {
          "type": "string",
          "description": "ISO timestamp string of the last publish action",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "dayId",
        "dayLabel",
        "dayOrder",
        "isPublic",
        "hasUnpublishedChanges",
        "version",
        "draftRows",
        "publishedRows",
        "updatedBy",
        "updatedByEmail",
        "updatedByName",
        "updatedAt",
        "publishedAt"
      ]
    },
    "PublicDailySchedule": {
      "title": "PublicDailySchedule",
      "description": "Publicly readable published schedule document for visitors containing only approved rows",
      "type": "object",
      "properties": {
        "dayId": {
          "type": "string",
          "description": "Day identifier",
          "enum": ["saturday", "sunday", "monday", "tuesday", "wednesday", "thursday", "friday"],
          "minLength": 6,
          "maxLength": 12
        },
        "dayLabel": {
          "type": "string",
          "description": "Arabic display name of the day",
          "minLength": 3,
          "maxLength": 30
        },
        "dayOrder": {
          "type": "number",
          "description": "Numeric order of the day (0 to 6)"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the schedule is public"
        },
        "publishedRows": {
          "type": "array",
          "description": "List of published clinic rows (max 60)"
        },
        "publishedAt": {
          "type": "string",
          "description": "ISO timestamp string of when the schedule was published",
          "minLength": 1,
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the publish operation"
        }
      },
      "required": [
        "dayId",
        "dayLabel",
        "dayOrder",
        "isPublic",
        "publishedRows",
        "publishedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account role and permissions record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "User full name",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Assigned role in the system",
          "enum": ["ADMIN", "EDITOR"]
        },
        "allowedDays": {
          "type": "array",
          "description": "Days the editor is allowed to modify (max 7)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was last updated"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "allowedDays",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail entry for schedule and system changes",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action code performed",
          "enum": [
            "CREATE_ROW",
            "UPDATE_ROW",
            "DELETE_ROW",
            "REORDER_ROWS",
            "COPY_ROW",
            "COPY_DAY",
            "PUBLISH_DAY",
            "UPDATE_SETTINGS",
            "UPDATE_ROLE",
            "DELETE_USER",
            "SEED_DATA",
            "UNDO"
          ]
        },
        "dayId": {
          "type": "string",
          "description": "Affected day ID or system scope",
          "minLength": 1,
          "maxLength": 40
        },
        "dayLabel": {
          "type": "string",
          "description": "Arabic label of affected day or section",
          "minLength": 1,
          "maxLength": 60
        },
        "details": {
          "type": "string",
          "description": "Human-readable Arabic summary of the change",
          "minLength": 1,
          "maxLength": 500
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who performed the action",
          "minLength": 1,
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Email of the user who performed the action",
          "minLength": 3,
          "maxLength": 160
        },
        "userName": {
          "type": "string",
          "description": "Display name of the user who performed the action",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the audit event"
        }
      },
      "required": [
        "action",
        "dayId",
        "dayLabel",
        "details",
        "userId",
        "userEmail",
        "userName",
        "createdAt"
      ]
    },
    "ReminderSettings": {
      "title": "ReminderSettings",
      "description": "Daily push reminder and Facebook Page automatic schedule publishing configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether daily push reminders are enabled"
        },
        "time": {
          "type": "string",
          "description": "Daily scheduled time in HH:mm format (Africa/Cairo)",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "type": "string",
          "description": "Timezone identifier (Africa/Cairo)"
        },
        "targetDay": {
          "type": "string",
          "description": "Target schedule day for reminders",
          "enum": ["today", "tomorrow"]
        },
        "title": {
          "type": "string",
          "description": "Notification title template",
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "description": "Notification body template",
          "maxLength": 500
        },
        "fbAutoPostEnabled": {
          "type": "boolean",
          "description": "Whether daily automatic Facebook Page schedule publishing is enabled"
        },
        "lastSentDate": {
          "type": "string",
          "description": "Server-managed YYYY-MM-DD date of last sent reminder"
        },
        "lastFbPostDate": {
          "type": "string",
          "description": "Server-managed YYYY-MM-DD date of last automatic Facebook post"
        }
      },
      "required": ["enabled", "time", "targetDay", "title", "body"]
    },
    "PosterImage": {
      "title": "PosterImage",
      "description": "Rendered 1080x1350 JPEG schedule poster for Facebook Graph API publishing",
      "type": "object",
      "properties": {
        "dayId": {
          "type": "string",
          "description": "Day identifier",
          "enum": ["saturday", "sunday", "monday", "tuesday", "wednesday", "thursday", "friday"]
        },
        "version": {
          "type": "number",
          "description": "Version of the schedule matching the poster image"
        },
        "imageBase64": {
          "type": "string",
          "description": "Base64 encoded JPEG binary data without data: URI prefix (max 900KB)",
          "maxLength": 900000
        },
        "mime": {
          "type": "string",
          "description": "MIME type (image/jpeg)",
          "enum": ["image/jpeg"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when image was generated and cached"
        }
      },
      "required": ["dayId", "version", "imageBase64", "mime"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CenterSettings" },
      "description": "Global center configuration and visual branding settings"
    },
    "/schedules/{dayId}": {
      "schema": { "$ref": "#/entities/DailySchedule" },
      "description": "Daily clinic schedules for Saturday through Friday"
    },
    "/publicSchedules/{dayId}": {
      "schema": { "$ref": "#/entities/PublicDailySchedule" },
      "description": "Public published schedules for visitors"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User accounts and role assignments (ADMIN, EDITOR, VIEWER)"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit log entries for modifications"
    },
    "/appConfig/{id}": {
      "schema": { "$ref": "#/entities/ReminderSettings" },
      "description": "Daily reminder and Facebook Page automatic publishing configuration"
    },
    "/posterImages/{dayId}": {
      "schema": { "$ref": "#/entities/PosterImage" },
      "description": "Cached 1080x1350 JPEG poster images for Meta Graph API v21.0 publishing"
    }
  }
}
