rules_version = '2';

// ============================================================================
// WORST-CASE EXPRESSION BUDGET CALCULATION (30 ROWS ATOMIC TRANSACTION)
// ============================================================================
// Firestore enforces a hard cap of 1,000 evaluated expressions per request
// (including all documents written inside a single atomic `runTransaction`).
// Every save in Clinic-Schedule atomically writes TWO documents in one transaction:
//   1) `schedules/{dayId}`
//   2) `publicSchedules/{dayId}`
//
// Breakdown for worst case (30 rows in `draftRows` and `publishedRows`):
// - `isValidRowItem(row)`:
//     1 (`row is map`)
//   + 1 (`row.id is string`)
//   + 2 (`row.clinicName is string && row.clinicName.size() <= 120`)
//   + 2 (`row.doctorName is string && row.doctorName.size() <= 120`)
//   + 2 (`row.startTime is string && row.startTime.size() <= 40`)
//   + 2 (`row.endTime is string && row.endTime.size() <= 40`)
//   = 10 expressions per row.
//
// - `isValidRowsList(rows)` (validates `draftRows` indices 0..29):
//     2 (`rows is list && rows.size() <= 30`)
//   + 30 * (1 size check `rows.size() <= i` + 10 in `isValidRowItem(rows[i])`)
//   = 2 + (30 * 11) = 332 expressions.
//
// - `schedules/{dayId}` write evaluation:
//   - Auth & role check (`isSignedIn`, `isValidId`, `isEditorForDay`): ~18 expressions
//   - Document scalar & equality checks (`keys().hasAll`, `dayId`, `dayLabel`,
//     `dayOrder`, `isPublic`, `hasUnpublishedChanges == false`, `version`,
//     `publishedRows == draftRows` [1 comparison], `updatedBy*`, `updatedAt`,
//     `publishedAt`, version increment): ~34 expressions
//   - `isValidRowsList(data.draftRows)`: 332 expressions
//   => Subtotal for `schedules/{dayId}` = 384 expressions.
//
// - `publicSchedules/{dayId}` write evaluation:
//   - Auth & role check (`isSignedIn`, `isValidId`, `isEditorForDay`): ~18 expressions
//   - Document scalar checks (`keys().hasAll`, `dayId`, `dayLabel`, `dayOrder`,
//     `isPublic`, `publishedAt`): ~14 expressions
//   - First-row lightweight check (`publishedRows is list && size() <= 30 &&
//     (size() == 0 || isValidRowItem(publishedRows[0]))`): 3 + 10 = 13 expressions
//   => Subtotal for `publicSchedules/{dayId}` = 45 expressions.
//
// TOTAL WORST-CASE EXPRESSIONS PER ATOMIC TRANSACTION (30 ROWS):
//   384 + 45 = 429 expressions (< 600 target budget, and well below 1,000 limit).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check endpoint
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email.lower() == 'ahmed0soliman6@gmail.com';
    }

    function authEmailDocId() {
      return request.auth.token.email.lower().replace('@', '_at_').replace('[.]', '_dot_').replace('[+]', '_plus_');
    }

    function isAdmin() {
      return isSuperAdminEmail() ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(authEmailDocId())) &&
          get(/databases/$(database)/documents/users/$(authEmailDocId())).data.role == 'ADMIN');
    }

    function isEditorForDay(dayId) {
      return isAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(authEmailDocId())) &&
          get(/databases/$(database)/documents/users/$(authEmailDocId())).data.role == 'EDITOR' &&
          dayId in get(/databases/$(database)/documents/users/$(authEmailDocId())).data.allowedDays);
    }

    function isStaff() {
      return isAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(authEmailDocId())) &&
          get(/databases/$(database)/documents/users/$(authEmailDocId())).data.role in ['ADMIN', 'EDITOR']);
    }

    function isValidAllowedDay(day) {
      return day in ['saturday', 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday'];
    }

    // Validate all 7 elements (indices 0..6) of allowedDays
    function isValidAllowedDaysList(days) {
      return days is list &&
        days.size() <= 7 &&
        (days.size() <= 0 || isValidAllowedDay(days[0])) &&
        (days.size() <= 1 || isValidAllowedDay(days[1])) &&
        (days.size() <= 2 || isValidAllowedDay(days[2])) &&
        (days.size() <= 3 || isValidAllowedDay(days[3])) &&
        (days.size() <= 4 || isValidAllowedDay(days[4])) &&
        (days.size() <= 5 || isValidAllowedDay(days[5])) &&
        (days.size() <= 6 || isValidAllowedDay(days[6]));
    }

    // 3. Entity Validation Blueprints
    function isValidCenterSettings(data) {
      return data.keys().hasAll([
          'complexName', 'associationName', 'registrationNumber',
          'rightLogoUrl', 'leftLogoUrl', 'address',
          'whatsappPhone', 'landlinePhone', 'dentalPhone', 'dentalLabel',
          'bgStartColor', 'bgEndColor', 'clinicHeaderColor',
          'doctorHeaderColor', 'fromHeaderColor', 'toHeaderColor',
          'footerBgColor'
        ]) &&
        data.complexName is string && data.complexName.size() >= 1 && data.complexName.size() <= 120 &&
        data.associationName is string && data.associationName.size() >= 1 && data.associationName.size() <= 160 &&
        data.registrationNumber is string && data.registrationNumber.size() >= 1 && data.registrationNumber.size() <= 60 &&
        data.rightLogoUrl is string && data.rightLogoUrl.size() <= 500 &&
        data.leftLogoUrl is string && data.leftLogoUrl.size() <= 500 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 200 &&
        data.whatsappPhone is string && data.whatsappPhone.size() >= 1 && data.whatsappPhone.size() <= 40 &&
        data.landlinePhone is string && data.landlinePhone.size() >= 1 && data.landlinePhone.size() <= 40 &&
        data.dentalPhone is string && data.dentalPhone.size() >= 1 && data.dentalPhone.size() <= 40 &&
        data.dentalLabel is string && data.dentalLabel.size() <= 60 &&
        data.bgStartColor is string && data.bgStartColor.size() >= 4 && data.bgStartColor.size() <= 30 &&
        data.bgEndColor is string && data.bgEndColor.size() >= 4 && data.bgEndColor.size() <= 30 &&
        data.clinicHeaderColor is string && data.clinicHeaderColor.size() >= 4 && data.clinicHeaderColor.size() <= 30 &&
        data.doctorHeaderColor is string && data.doctorHeaderColor.size() >= 4 && data.doctorHeaderColor.size() <= 30 &&
        data.fromHeaderColor is string && data.fromHeaderColor.size() >= 4 && data.fromHeaderColor.size() <= 30 &&
        data.toHeaderColor is string && data.toHeaderColor.size() >= 4 && data.toHeaderColor.size() <= 30 &&
        data.footerBgColor is string && data.footerBgColor.size() >= 4 && data.footerBgColor.size() <= 30 &&
        (!('postTemplate' in data) || (data.postTemplate is string && data.postTemplate.size() <= 2000));
    }

    // Lightweight per-row validation (10 expressions per row)
    function isValidRowItem(row) {
      return row is map &&
        row.id is string &&
        row.clinicName is string && row.clinicName.size() <= 120 &&
        row.doctorName is string && row.doctorName.size() <= 120 &&
        row.startTime is string && row.startTime.size() <= 40 &&
        row.endTime is string && row.endTime.size() <= 40;
    }

    // Array Guard (Pillar 5): Constrain list size <= 30 and validate first element type
    function isValidRowList(rows) {
      return rows is list &&
        rows.size() <= 30 &&
        (rows.size() == 0 || isValidRowItem(rows[0]));
    }

    function isValidPublicSchedule(data) {
      return data.keys().hasAll(['dayId', 'dayLabel', 'dayOrder', 'isPublic', 'publishedRows', 'publishedAt']) &&
        data.dayId is string && data.dayId in ['saturday', 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday'] &&
        data.dayLabel is string && data.dayLabel.size() >= 3 && data.dayLabel.size() <= 30 &&
        data.dayOrder is int && data.dayOrder >= 0 && data.dayOrder <= 6 &&
        data.isPublic is bool &&
        data.publishedAt is string && data.publishedAt.size() >= 1 && data.publishedAt.size() <= 60 &&
        isValidRowList(data.publishedRows);
    }

    function isValidDailySchedule(data) {
      return data.keys().hasAll([
          'dayId', 'dayLabel', 'dayOrder', 'isPublic', 'hasUnpublishedChanges',
          'version', 'draftRows', 'publishedRows', 'updatedBy',
          'updatedByEmail', 'updatedByName', 'updatedAt', 'publishedAt'
        ]) &&
        data.dayId is string && data.dayId in ['saturday', 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday'] &&
        data.dayLabel is string && data.dayLabel.size() >= 3 && data.dayLabel.size() <= 30 &&
        data.dayOrder is int && data.dayOrder >= 0 && data.dayOrder <= 6 &&
        data.isPublic is bool &&
        data.hasUnpublishedChanges == false &&
        data.version is int && data.version >= 1 && data.version <= 1000000 &&
        isValidRowList(data.draftRows) &&
        isValidRowList(data.publishedRows) &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 160 &&
        data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120 &&
        data.updatedAt is timestamp &&
        data.publishedAt is string && data.publishedAt.size() >= 1 && data.publishedAt.size() <= 60;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'allowedDays', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role is string && data.role in ['ADMIN', 'EDITOR'] &&
        isValidAllowedDaysList(data.allowedDays) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'dayId', 'dayLabel', 'details', 'userId', 'userEmail', 'userName', 'createdAt']) &&
        data.action is string && data.action in [
          'CREATE_ROW', 'UPDATE_ROW', 'DELETE_ROW', 'REORDER_ROWS',
          'COPY_ROW', 'COPY_DAY', 'PUBLISH_DAY', 'UPDATE_SETTINGS',
          'UPDATE_ROLE', 'DELETE_USER', 'SEED_DATA', 'UNDO'
        ] &&
        data.dayId is string && data.dayId.size() >= 1 && data.dayId.size() <= 40 &&
        data.dayLabel is string && data.dayLabel.size() >= 1 && data.dayLabel.size() <= 60 &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 500 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidReminderConfig(data) {
      return data.enabled is bool &&
        data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.targetDay in ['today', 'tomorrow'] &&
        data.title is string && data.title.size() <= 160 &&
        data.body is string && data.body.size() <= 500 &&
        (!('fbAutoPostEnabled' in data) || data.fbAutoPostEnabled is bool) &&
        (!('fbAutoStoryEnabled' in data) || data.fbAutoStoryEnabled is bool) &&
        (!('fbAutoPostTime' in data) || (data.fbAutoPostTime is string && data.fbAutoPostTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&
        (!('fbPostMode' in data) || data.fbPostMode in ['photo_with_caption', 'photo_only', 'text_only']) &&
        (!('fbTargetDay' in data) || data.fbTargetDay in ['today', 'tomorrow']) &&
        (!('fbFallbackMode' in data) || data.fbFallbackMode in ['text', 'skip']) &&
        (!('fbSkipEmptyDay' in data) || data.fbSkipEmptyDay is bool) &&
        (!('showFacebookCard' in data) || data.showFacebookCard is bool);
    }

    // 4. Collection Rules
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list, write: if isSuperAdminEmail();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isSignedIn() && isValidId(settingId) && isAdmin() && isValidCenterSettings(incoming());
      allow delete: if false;
    }

    match /publicSchedules/{dayId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) && isValidPublicSchedule(incoming());
      allow delete: if false;
    }

    match /schedules/{dayId} {
      allow get: if isValidId(dayId) && isStaff();
      allow list: if isStaff();
      allow create: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) && isValidDailySchedule(incoming()) && incoming().dayId == dayId;
      allow update: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) && isValidDailySchedule(incoming()) &&
        (!('dayId' in existing()) || incoming().dayId == existing().dayId) && (
          isAdmin() || !('version' in existing()) || incoming().version == existing().version + 1
        );
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (
        isAdmin() || (isSignedIn() && userId == authEmailDocId())
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isAdmin() && isValidUserProfile(incoming()) &&
        incoming().uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && isAdmin() && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'allowedDays', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isStaff();
      allow list: if isAdmin() || (isSignedIn() && existing().userEmail == request.auth.token.email);
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().userEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    match /fcmTokens/{tokenId} {
      allow get, list: if false;
      allow create, update: if isValidId(tokenId) &&
        incoming().email is string &&
        incoming().email.size() >= 3 &&
        incoming().email.size() <= 160 &&
        incoming().token is string &&
        incoming().token.size() >= 10 &&
        incoming().token.size() <= 4096 &&
        (
          (isSignedIn() && isStaff() && request.auth.token.email.lower() == incoming().email.lower()) ||
          (incoming().email == 'public@subscriber.local' && incoming().uid == 'public')
        );
      allow delete: if isValidId(tokenId);
    }

    match /appConfig/{id} {
      allow get, list: if isStaff();
      allow create: if isSignedIn() && isValidId(id) && isAdmin() &&
        isValidReminderConfig(incoming()) &&
        !('lastSentDate' in incoming()) &&
        !('lastFbPostDate' in incoming()) &&
        !incoming().keys().hasAny([
          'lastSentDate',
          'lastFbPostDate',
          'lastFbPostTargetDate',
          'lastFbPostWarning',
          'lastFbPostStatus',
          'lastFbPostAt',
          'lastFbPostId',
          'lastFbPostError',
          'fbPostAttempts',
          'fbPostLockUntil',
          'lastCronRunAt'
        ]);
      allow update: if isSignedIn() && isValidId(id) && isAdmin() &&
        isValidReminderConfig(incoming()) &&
        !('lastSentDate' in incoming().diff(existing()).affectedKeys()) &&
        !('lastFbPostDate' in incoming().diff(existing()).affectedKeys()) &&
        !incoming().diff(existing()).affectedKeys().hasAny([
          'lastSentDate',
          'lastFbPostDate',
          'lastFbPostTargetDate',
          'lastFbPostWarning',
          'lastFbPostStatus',
          'lastFbPostAt',
          'lastFbPostId',
          'lastFbPostError',
          'fbPostAttempts',
          'fbPostLockUntil',
          'lastCronRunAt'
        ]);
      allow delete: if false;
    }

    match /posterImages/{dayId} {
      allow get, list: if isStaff();
      allow create, update: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) &&
        incoming().dayId == dayId &&
        incoming().version is int && incoming().version >= 1 &&
        incoming().imageBase64 is string && incoming().imageBase64.size() < 900000 &&
        incoming().mime == 'image/jpeg';
      allow delete: if false;
    }

    match /posterMeta/{dayId} {
      allow get, list: if isStaff();
      allow create, update: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) &&
        incoming().dayId == dayId &&
        incoming().version is int && incoming().version >= 1 &&
        incoming().bytes is int && incoming().bytes >= 1 && incoming().bytes < 900000 &&
        incoming().updatedAt is string && incoming().updatedAt.size() <= 64;
      allow delete: if false;
    }
  }
}

