rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check endpoint
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email.lower() == 'ahmed0soliman6@gmail.com';
    }

    function authEmailDocId() {
      return request.auth.token.email.lower().replace('@', '_at_').replace('[.]', '_dot_').replace('[+]', '_plus_');
    }

    function isAdmin() {
      return isSuperAdminEmail() ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(authEmailDocId())) &&
          get(/databases/$(database)/documents/users/$(authEmailDocId())).data.role == 'ADMIN');
    }

    function isEditorForDay(dayId) {
      return isAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(authEmailDocId())) &&
          get(/databases/$(database)/documents/users/$(authEmailDocId())).data.role == 'EDITOR' &&
          dayId in get(/databases/$(database)/documents/users/$(authEmailDocId())).data.allowedDays);
    }

    function isStaff() {
      return isAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(authEmailDocId())) &&
          get(/databases/$(database)/documents/users/$(authEmailDocId())).data.role in ['ADMIN', 'EDITOR']);
    }

    function isValidAllowedDay(day) {
      return day in ['saturday', 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday'];
    }

    // 3. Entity Validation Blueprints
    function isValidCenterSettings(data) {
      return data.keys().hasAll([
          'complexName', 'associationName', 'registrationNumber',
          'rightLogoUrl', 'leftLogoUrl', 'address',
          'whatsappPhone', 'landlinePhone', 'dentalPhone', 'dentalLabel',
          'bgStartColor', 'bgEndColor', 'clinicHeaderColor',
          'doctorHeaderColor', 'fromHeaderColor', 'toHeaderColor',
          'footerBgColor'
        ]) &&
        data.complexName is string && data.complexName.size() >= 1 && data.complexName.size() <= 120 &&
        data.associationName is string && data.associationName.size() >= 1 && data.associationName.size() <= 160 &&
        data.registrationNumber is string && data.registrationNumber.size() >= 1 && data.registrationNumber.size() <= 60 &&
        data.rightLogoUrl is string && data.rightLogoUrl.size() <= 500 &&
        data.leftLogoUrl is string && data.leftLogoUrl.size() <= 500 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 200 &&
        data.whatsappPhone is string && data.whatsappPhone.size() >= 1 && data.whatsappPhone.size() <= 40 &&
        data.landlinePhone is string && data.landlinePhone.size() >= 1 && data.landlinePhone.size() <= 40 &&
        data.dentalPhone is string && data.dentalPhone.size() >= 1 && data.dentalPhone.size() <= 40 &&
        data.dentalLabel is string && data.dentalLabel.size() <= 60 &&
        data.bgStartColor is string && data.bgStartColor.size() >= 4 && data.bgStartColor.size() <= 30 &&
        data.bgEndColor is string && data.bgEndColor.size() >= 4 && data.bgEndColor.size() <= 30 &&
        data.clinicHeaderColor is string && data.clinicHeaderColor.size() >= 4 && data.clinicHeaderColor.size() <= 30 &&
        data.doctorHeaderColor is string && data.doctorHeaderColor.size() >= 4 && data.doctorHeaderColor.size() <= 30 &&
        data.fromHeaderColor is string && data.fromHeaderColor.size() >= 4 && data.fromHeaderColor.size() <= 30 &&
        data.toHeaderColor is string && data.toHeaderColor.size() >= 4 && data.toHeaderColor.size() <= 30 &&
        data.footerBgColor is string && data.footerBgColor.size() >= 4 && data.footerBgColor.size() <= 30;
    }

    function isValidRowItem(row) {
      return row is map &&
        row.keys().hasAll(['id', 'clinicName', 'doctorName', 'startTime', 'endTime', 'sortOrder']) &&
        row.id is string && row.id.size() >= 1 && row.id.size() <= 80 &&
        row.clinicName is string && row.clinicName.size() <= 120 &&
        row.doctorName is string && row.doctorName.size() <= 120 &&
        row.startTime is string && row.startTime.size() <= 40 &&
        row.endTime is string && row.endTime.size() <= 40 &&
        row.sortOrder is int && row.sortOrder >= 0 && row.sortOrder <= 500;
    }

    function isValidRowsList(rows) {
      return rows is list &&
        rows.size() <= 60 &&
        (rows.size() == 0 || isValidRowItem(rows[0]));
    }

    function isValidPublicSchedule(data) {
      return data.keys().hasAll(['dayId', 'dayLabel', 'dayOrder', 'isPublic', 'publishedRows', 'publishedAt']) &&
        data.dayId is string && data.dayId in ['saturday', 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday'] &&
        data.dayLabel is string && data.dayLabel.size() >= 3 && data.dayLabel.size() <= 30 &&
        data.dayOrder is int && data.dayOrder >= 0 && data.dayOrder <= 6 &&
        data.isPublic is bool &&
        data.publishedAt is string && data.publishedAt.size() >= 1 && data.publishedAt.size() <= 60 &&
        isValidRowsList(data.publishedRows);
    }

    function isValidDailySchedule(data) {
      return data.keys().hasAll([
          'dayId', 'dayLabel', 'dayOrder', 'isPublic', 'hasUnpublishedChanges',
          'version', 'draftRows', 'publishedRows', 'updatedBy',
          'updatedByEmail', 'updatedByName', 'updatedAt', 'publishedAt'
        ]) &&
        data.dayId is string && data.dayId in ['saturday', 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday'] &&
        data.dayLabel is string && data.dayLabel.size() >= 3 && data.dayLabel.size() <= 30 &&
        data.dayOrder is int && data.dayOrder >= 0 && data.dayOrder <= 6 &&
        data.isPublic is bool &&
        data.hasUnpublishedChanges is bool &&
        data.version is int && data.version >= 1 && data.version <= 1000000 &&
        isValidRowsList(data.draftRows) &&
        isValidRowsList(data.publishedRows) &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 160 &&
        data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120 &&
        data.updatedAt is timestamp &&
        data.publishedAt is string && data.publishedAt.size() >= 1 && data.publishedAt.size() <= 60;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'allowedDays', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role is string && data.role in ['ADMIN', 'EDITOR'] &&
        data.allowedDays is list && data.allowedDays.size() <= 7 &&
        (data.allowedDays.size() == 0 || isValidAllowedDay(data.allowedDays[0])) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'dayId', 'dayLabel', 'details', 'userId', 'userEmail', 'userName', 'createdAt']) &&
        data.action is string && data.action in [
          'CREATE_ROW', 'UPDATE_ROW', 'DELETE_ROW', 'REORDER_ROWS',
          'COPY_ROW', 'COPY_DAY', 'PUBLISH_DAY', 'UPDATE_SETTINGS',
          'UPDATE_ROLE', 'DELETE_USER', 'SEED_DATA', 'UNDO'
        ] &&
        data.dayId is string && data.dayId.size() >= 1 && data.dayId.size() <= 40 &&
        data.dayLabel is string && data.dayLabel.size() >= 1 && data.dayLabel.size() <= 60 &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 500 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list, write: if isSuperAdminEmail();
    }

    match /settings/{settingId} {
      // Public visitors can read the center branding document
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isSignedIn() && isValidId(settingId) && isAdmin() && isValidCenterSettings(incoming());
      allow delete: if false;
    }

    match /publicSchedules/{dayId} {
      // Public visitors can read approved schedules
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) && isValidPublicSchedule(incoming());
      allow delete: if false;
    }

    match /schedules/{dayId} {
      // Authorized staff can read; public visitors can also read if document is missing or isPublic is true
      allow get: if isStaff() || resource == null || (resource.data.isPublic == true);
      allow list: if isStaff() || resource == null || (resource.data.isPublic == true);
      allow create: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) && isValidDailySchedule(incoming()) && incoming().dayId == dayId;
      allow update: if isSignedIn() && isValidId(dayId) && isEditorForDay(dayId) && isValidDailySchedule(incoming()) && incoming().dayId == dayId;
      allow delete: if false;
    }

    match /users/{userId} {
      // Single permissions source of truth: users/{emailDocId}
      allow get: if isValidId(userId) && (
        isAdmin() || (isSignedIn() && userId == authEmailDocId())
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isAdmin() && isValidUserProfile(incoming()) &&
        incoming().uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && isAdmin() && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'allowedDays', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isStaff();
      allow list: if isAdmin() || (isSignedIn() && existing().userEmail == request.auth.token.email);
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().userEmail == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
